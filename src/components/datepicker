function initDatepicker() {
  document.querySelectorAll("[data-pp-datepicker]").forEach(input => {
    const onChangeFn = input.dataset.onchange;

    /* =========================
       ATTRIBUTES
    ========================= */
    input.type = DEFAULTS.dateInputType;

    // Today (default minimum)
    const today = new Date();
    const yyyy = today.getFullYear();
    const mm = String(today.getMonth() + 1).padStart(2, "0");
    const dd = String(today.getDate()).padStart(2, "0");

    /* =========================
       DATE RANGE SUPPORT (NEW)
    ========================= */

    // Utility: MM/DD/YYYY → YYYY-MM-DD
    function toISO(val) {
      if (!val) return null;
      const [m, d, y] = val.split("/");
      return `${y}-${m.padStart(2, "0")}-${d.padStart(2, "0")}`;
    }

    // Apply minimum date
    if (input.dataset.minDate) {
      input.min = toISO(input.dataset.minDate);
    } else {
      // default behavior: disable past dates
      input.min = `${yyyy}-${mm}-${dd}`;
    }

    // Apply maximum date (if provided)
    if (input.dataset.maxDate) {
      input.max = toISO(input.dataset.maxDate);
    } else {
      input.removeAttribute("max");
    }

    /* =========================
       STYLES (UNCHANGED)
     ========================= */
    input.style.width = input.dataset.width || DEFAULTS.dateWidth;
    input.style.height = input.dataset.height || DEFAULTS.dateHeight;
    input.style.padding = DEFAULTS.datePadding;
    input.style.fontFamily = DEFAULTS.dateFontFamily;
    input.style.fontSize = DEFAULTS.dateFontSize;
    input.style.fontWeight = DEFAULTS.dateFontWeight;
    input.style.color = input.dataset.color || DEFAULTS.dateTextColor;
    input.style.backgroundColor =
      input.dataset.bgcolor || DEFAULTS.dateBgColor;
    input.style.border = `1px solid ${
      input.dataset.bordercolor || DEFAULTS.dateBorderColor
    }`;
    input.style.borderRadius = DEFAULTS.dateBorderRadius;
    input.style.cursor = DEFAULTS.dateCursor;
    input.style.outline = "none";

    /* =========================
       FOCUS HANDLING
    ========================= */
    input.addEventListener("focus", () => {
      input.style.borderColor = DEFAULTS.dateFocusBorderColor;
    });

    input.addEventListener("blur", () => {
      input.style.borderColor =
        input.dataset.bordercolor || DEFAULTS.dateBorderColor;
    });

    /* =========================
       ONCHANGE (CSP-SAFE)
    ========================= */
    if (onChangeFn && typeof window[onChangeFn] === "function") {
      input.addEventListener("change", e =>
        window[onChangeFn](e.target.value, e)
      );
    }
  });
}
